# Multi-arch base image: runs on amd64 (Render) AND arm64 (local Apple
# silicon / other hosts).
#
# The suite is pinned (bookworm) rather than floating: `python:3.11-slim`
# silently moves to the next Debian release, whose chromium/chromium-driver
# dependency set can differ, and that is exactly how an intermittent
# `Exited with status 1` build appears after code that has not changed.
FROM python:3.11-slim-bookworm

# Application data lives in MongoDB Atlas - the container holds NO database
# file and needs no persistent volume (Render's filesystem may be ephemeral).
#
# CHROME_BINARY ..... Debian's chromium browser (built for amd64 AND arm64).
# CHROMEDRIVER_PATH . matching driver from the same Debian package source.
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    MALLOC_ARENA_MAX=2 \
    CHROME_BINARY=/usr/bin/chromium \
    CHROMEDRIVER_PATH=/usr/bin/chromium-driver

WORKDIR /app

# Chromium + version-matched driver + fonts, straight from the Debian repos.
RUN apt-get update && apt-get install -y --no-install-recommends \
        chromium \
        chromium-driver \
        fonts-liberation \
        fonts-dejavu-core \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code (no database file is baked in - MongoDB is the store).
COPY . .

# Unprivileged runtime user with a writable home/temp for Chromium.
RUN mkdir -p /tmp/chrome \
    && useradd --create-home --shell /bin/bash appuser \
    && chown -R appuser:appuser /app /home/appuser /tmp/chrome

# Startup script: starts Gunicorn bound to 0.0.0.0:$PORT.
COPY --chmod=755 docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

USER appuser

EXPOSE 10000

HEALTHCHECK --interval=30s --timeout=10s --start-period=45s --retries=3 \
  CMD python -c "import os, urllib.request; urllib.request.urlopen('http://127.0.0.1:%s/api/health' % os.environ.get('PORT', '10000'), timeout=5)" || exit 1

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
