# ============================================================
# map_competitor environment variables
# Copy this file to ".env" and fill in real values.
# ".env" is git-ignored - secrets never reach GitHub.
# ============================================================

# --- Database (MongoDB Atlas) -------------------------------------
# Connection string from Atlas: MongoDB Atlas -> Connect -> Drivers.
# Use the SRV format. NEVER commit the real value.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Database name inside the cluster (created automatically on first use)
MONGODB_DATABASE=competitor_intelligence

# --- API keys ---------------------------------------------------------
# Groq API key (free): https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
# Google Gemini API key (optional): https://aistudio.google.com/
GEMINI_API_KEY=
# Legacy alias some code paths still read (optional)
GROK_API_KEY=

# --- Backend link (which API the app talks to) -------------------------
# OPTIONAL - the app auto-detects its backend when this is empty:
#   localhost pages: local :10000 -> local :5000 -> the deployed Render API
#   deployed pages : the relative "/api" path (Vercel rewrite -> Render)
#
# The frontend is a static SPA with no build step, so it cannot read .env
# itself. This value is read by serve_local.py, which proxies /api/* to it.
# For the Vercel deployment the same link must live in frontend/vercel.json
# (vercel.json cannot read environment variables).
API_BASE_URL=
# Examples:
# API_BASE_URL=https://map-compete.onrender.com/api   # deployed backend
# API_BASE_URL=http://127.0.0.1:10000/api             # this machine's backend

# --- Ports ------------------------------------------------------------
# Port the Flask API listens on. Render injects its own $PORT - do not
# override it there. Local dev default is 10000 (set 5000 for old behaviour).
PORT=10000
# Host port for the frontend container (local Docker only; Vercel ignores it)
WEB_PORT=3000
# Host port for the backend container (local Docker only)
API_PORT=5000

# --- Gunicorn (production server inside Docker/Render) ---------------
# Long scrape requests must be allowed to finish; a project-wide scrape
# can take ~10 minutes, hence the 1800s timeout.
# One worker process, several threads: the browser needs most of a 512 MB
# instance, and threads keep the health check and the reads answered while a
# scrape holds one thread. GUNICORN_WORKERS=1 matches render.yaml.
GUNICORN_WORKERS=1
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=1800
# Chromium's JS heap budget is per renderer, not total RSS. One browser-backed
# operation is admitted at a time; extra requests receive 429 SCRAPER_BUSY.
SCRAPE_JS_HEAP_MB=192
SCRAPE_BLOCK_IMAGES=true
MALLOC_ARENA_MAX=2

# --- CORS ---------------------------------------------------------------
# "*" allows any origin (works out of the box for local dev). In production
# restrict to your Vercel domain, comma separated:
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000
CORS_ORIGINS=*